 391:                 .setUserId(refreshTokenDO.getUserId()).setUserType(refreshTokenDO.getUserType())
 392:                 .setUserInfo(buildUserInfo(refreshTokenDO.getUserId(), refreshTokenDO.getUserType()))
 393:                 .setClientId(clientDO.getClientId()).setScopes(refreshTokenDO.getScopes())
 394:                 .setRefreshToken(refreshTokenDO.getRefreshToken())
