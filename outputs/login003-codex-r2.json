 308:     /**
 309:      * ZS-LOGIN-003���û�ά�ȳ�����ʵ��ִ���壬<b>����</b>�ڡ������⻧���������ڱ����á�
 310:      *
 311:      * @param userId   �û����
 312:      * @param userType �û�����
 313:      */
 314:     private void doRemoveAccessTokenByUser(Long userId, Integer userType) {
 315:         // 1. ���ܴ������� refresh-token ȫ����access-token ���� �� refresh-token ֱ��
 316:         List<OAuth2AccessTokenDO> accessTokens =
 317:                 ObjectUtil.defaultIfNull(oauth2AccessTokenMapper.selectListByUserIdAndUserType(userId, userType),
 318:                         Collections.emptyList());
 319:         List<OAuth2RefreshTokenDO> refreshTokens =
 320:                 ObjectUtil.defaultIfNull(oauth2RefreshTokenMapper.selectListByUserIdAndUserType(userId, userType),
 321:                         Collections.emptyList());
 322:         // ZS-LOGIN-002 P2-A��ȥ�� + ��Ȼ������ refresh-token��ȷ�����������������ȶ�˳���ȡ����
 323:         Set<String> sortedRefreshTokens = new TreeSet<>();
 324:         for (OAuth2AccessTokenDO accessToken : accessTokens) {
 325:             if (StrUtil.isNotEmpty(accessToken.getRefreshToken())) {
 326:                 sortedRefreshTokens.add(accessToken.getRefreshToken());
 327:             }
 328:         }
 329:         // ZS-LOGIN-003��refresh-token ֱ�鲹�롸����ˢ��ƾ�ݡ����� access-token ��¼�����Ʒ��ֲ��ˣ�
 330:         int orphanCount = 0;
 331:         for (OAuth2RefreshTokenDO refreshTokenDO : refreshTokens) {
 332:             String refreshToken = refreshTokenDO.getRefreshToken();
 333:             if (StrUtil.isEmpty(refreshToken)) {
 334:                 continue;
 335:             }
 336:             if (sortedRefreshTokens.add(refreshToken)) {
 337:                 orphanCount++;
 338:             }
 339:         }
 340:         if (sortedRefreshTokens.isEmpty()) {
 341:             return; // ���û����κλỰ���޺��ղ���������������д��־��
 342:         }
 343:         // 2. ���ȶ�˳���������������
 344:         for (String refreshToken : sortedRefreshTokens) {
 345:             // ZS-LOGIN-002������ + �������ض�
 346:             oauth2RefreshTokenMapper.selectByRefreshTokenForUpdate(refreshToken);
 347:             // �ҵ��� refresh-token ��Ӧ����һ access-token ��Ϊ fallback������ˢ��ƾ��û�� fallback��Ϊ null��
 348:             OAuth2AccessTokenDO fallback = null;
 349:             for (OAuth2AccessTokenDO at : accessTokens) {
 350:                 if (refreshToken.equals(at.getRefreshToken())) {
 351:                     fallback = at;
 352:                     break;
 353:                 }
 354:             }
 355:             // �������ض������ǲ���ˢ���ڻ���ǰ�ղ�����´��ʷ������ƣ����Ự���
 356:             for (OAuth2AccessTokenDO aliveToken : listAliveAccessTokens(refreshToken, fallback)) {
 357:                 oauth2AccessTokenMapper.deleteById(aliveToken.getId());
 358:                 revokeWithTombstone(aliveToken.getAccessToken(), aliveToken.getExpiresTime());
 359:             }
 360:             // ZS-LOGIN-003 codex r1 P1��ɾ��ǰ�ȶ�ˢ������ʣ����Ч�ڣ�ɾ����鲻�������䳷��Ĺ����
 361:             // ��ס������Ȩ/�ſ�·���Ӿ� DB ���ջ����
 362:             OAuth2RefreshTokenDO revokeTarget = oauth2RefreshTokenMapper.selectByRefreshToken(refreshToken);
 363:             // ɾ��ˢ������
 364:             oauth2RefreshTokenMapper.deleteByRefreshToken(refreshToken);
 365:             // ZS-LOGIN-003�������ˢ�����Ʊ������������ơ�ʱ����������ת��ƾ�ݣ�ZS-LOGIN-001 ����·��д�룬
 366:             // key �� refreshToken ����TTL �̳�ˢ�����ƣ����Թ���ˢ��ƾ�ݶ�������Ψһ������ʱ��
 367:             revokeWithTombstone(refreshToken, revokeTarget != null ? revokeTarget.getExpiresTime() : null);
 368:             // ZS-LOGIN-002���Ự�սᣬ�������ʼ�
 369:             deleteSessionGenerationQuietly(refreshToken);
 370:         }
 371:         // ZS-LOGIN-003 codex r1 P1��һ��ʧЧδ���ѵ� OAuth2 ��Ȩ�롪������/����ǰǩ���� code ��������
 372:         // ��Ч�����Կɾ� grantAuthorizationCodeForAccessToken �һ����»Ự�������󸴻
 373:         int revokedCodes = oauth2CodeMapper.deleteByUserIdAndUserType(userId, userType);
 374:         if (revokedCodes > 0 && log.isInfoEnabled()) {
 375:             log.info("[removeAccessToken][ZS-LOGIN-003 �û�({}/{}) ��δ������Ȩ����һ��ʧЧ������({})]", userType, userId, revokedCodes);
 376:         }
 377:         // 3. ZS-LOGIN-003����ƿ�׷�٣����ƴ�������־�������������û���ʶ��
 378:         if (log.isInfoEnabled()) {
 379:             log.info("[removeAccessToken][ZS-LOGIN-003 �û�({}/{}) ��ȫ���Ự�ѳ������Ự��({})�����й���ˢ��ƾ��({})]",
 380:                     userType, userId, sortedRefreshTokens.size(), orphanCount);
 381:         }
 382:     }
