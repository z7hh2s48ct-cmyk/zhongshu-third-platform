 396:         // ���ȴ� refreshToken ��ȡ�⻧��ţ����� ThreadLocal ����Ⱦʱ���� tenantId Ϊ null
 397:         // ���ܹ����� issue��https://t.zsxq.com/JIi5G
 398:         Long tenantId = refreshTokenDO.getTenantId();
