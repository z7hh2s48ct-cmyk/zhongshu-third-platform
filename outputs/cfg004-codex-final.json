        <el-input v-model="formData.name" placeholder="请输入参数名�? />
      </el-form-item>
      <el-form-item label="参数键名" prop="key">
        <el-input v-model="formData.key" placeholder="请输入参数键�? />
      </el-form-item>
      <el-form-item label="参数键�? prop="value">
        <el-input v-model="formData.value" placeholder="请输入参数键�? />
      </el-form-item>
      <el-form-item label="是否可见" prop="visible">
        <el-radio-group v-model="formData.visible">
