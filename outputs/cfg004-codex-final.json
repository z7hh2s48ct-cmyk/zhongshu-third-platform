+        // 热生效：消费端立即读到新值
+        ConfigDO updated = configService.getConfigByKey("sys.login.captcha-max-retry");
+        assertEquals("7", updated.getValue());
+        // 且不需要重启
+        assertFalse(configValueValidator.isRestartRequired("sys.login.captcha-max-retry"));
