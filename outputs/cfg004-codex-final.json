    @Import({
            // DB 配置�?            ZszjDataSourceAutoConfiguration.class, // 自己�?DB 配置�?            DataSourceAutoConfiguration.class, // Spring DB 自动配置�?            DataSourceTransactionManagerAutoConfiguration.class, // Spring 事务自动配置�?            DruidDataSourceAutoConfigure.class, // Druid 自动配置�?            SqlInitializationTestConfiguration.class, // SQL 初始�?            // MyBatis 配置�?            ZszjMybatisAutoConfiguration.class, // 自己�?MyBatis 配置�?            MybatisPlusAutoConfiguration.class, // MyBatis 的自动配置类
            MybatisPlusJoinAutoConfiguration.class, // MyBatis 的Join配置�?
            // 其它配置�?            SpringUtil.class
    })
    public static class Application {
    }

}
