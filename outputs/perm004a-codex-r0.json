3:import cn.hutool.core.collection.CollUtil;
4:import cn.zszj.framework.common.exception.enums.GlobalErrorCodeConstants;
5:import cn.zszj.framework.common.pojo.CommonResult;
6:import cn.zszj.framework.security.core.LoginUser;
7:import cn.zszj.framework.security.core.util.SecurityFrameworkUtils;
8:import cn.zszj.framework.tenant.config.TenantProperties;
9:import cn.zszj.framework.tenant.core.context.TenantContextHolder;
10:import cn.zszj.framework.tenant.core.service.TenantFrameworkService;
11:import cn.zszj.framework.web.config.WebProperties;
12:import cn.zszj.framework.web.core.filter.ApiRequestFilter;
13:import cn.zszj.framework.web.core.handler.GlobalExceptionHandler;
14:import cn.zszj.framework.web.core.util.WebFrameworkUtils;
15:import jakarta.servlet.FilterChain;
16:import jakarta.servlet.ServletException;
17:import jakarta.servlet.http.HttpServletRequest;
18:import jakarta.servlet.http.HttpServletResponse;
19:import lombok.extern.slf4j.Slf4j;
20:import org.springframework.util.AntPathMatcher;
21:
22:import java.io.IOException;
23:import java.util.Objects;
24:import java.util.Set;
25:
26:/**
27: * 多租户 Security Web 过滤器
28: * 1. 如果是登陆的用户，校验是否有权限访问该租户，避免越权问题。
29: * 2. 如果请求未带租户的编号，检查是否是忽略的 URL，否则也不允许访问。
30: * 3. 校验租户是合法，例如说被禁用、到期
31: *
32: * @author 芋道源码
33: */
34:@Slf4j
35:public class TenantSecurityWebFilter extends ApiRequestFilter {
36:
37:    private final TenantProperties tenantProperties;
38:
39:    /**
40:     * 允许忽略租户的 URL 列表
41:     *
42:     * 目的：解决 <a href="https://gitee.com/zhijiantianya/yudao-cloud/issues/ICUQL9">修改配置会导致 @TenantIgnore Controller 接口过滤失效</>
43:     */
44:    private final Set<String> ignoreUrls;
45:
46:    private final AntPathMatcher pathMatcher;
47:
48:    private final GlobalExceptionHandler globalExceptionHandler;
49:    private final TenantFrameworkService tenantFrameworkService;
50:
51:    public TenantSecurityWebFilter(WebProperties webProperties,
52:                                   TenantProperties tenantProperties,
53:                                   Set<String> ignoreUrls,
54:                                   GlobalExceptionHandler globalExceptionHandler,
55:                                   TenantFrameworkService tenantFrameworkService) {
56:        super(webProperties);
57:        this.tenantProperties = tenantProperties;
58:        this.ignoreUrls = ignoreUrls;
59:        this.pathMatcher = new AntPathMatcher();
60:        this.globalExceptionHandler = globalExceptionHandler;
61:        this.tenantFrameworkService = tenantFrameworkService;
62:    }
63:
64:    @Override
65:    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
66:            throws ServletException, IOException {
67:        Long tenantId = TenantContextHolder.getTenantId();
68:        // 1. 登陆的用户，校验是否有权限访问该租户，避免越权问题。
69:        LoginUser user = SecurityFrameworkUtils.getLoginUser();
70:        if (user != null) {
71:            // 如果获取不到租户编号，则尝试使用登陆用户的租户编号
72:            if (tenantId == null) {
73:                tenantId = user.getTenantId();
74:                TenantContextHolder.setTenantId(tenantId);
75:            // 如果传递了租户编号，则进行比对租户编号，避免越权问题
76:            } else if (!Objects.equals(user.getTenantId(), TenantContextHolder.getTenantId())) {
77:                log.error("[doFilterInternal][租户({}) User({}/{}) 越权访问租户({}) URL({}/{})]",
78:                        user.getTenantId(), user.getId(), user.getUserType(),
79:                        TenantContextHolder.getTenantId(), request.getRequestURI(), request.getMethod());
80:                WebFrameworkUtils.writeJSON(request, response, CommonResult.error(GlobalErrorCodeConstants.FORBIDDEN.getCode(),
81:                        "您无权访问该租户的数据"));
82:                return;
83:            }
84:        }
85:
86:        // 如果非允许忽略租户的 URL，则校验租户是否合法
87:        if (!isIgnoreUrl(request)) {
88:            // 2. 如果请求未带租户的编号，不允许访问。
89:            if (tenantId == null) {
90:                log.error("[doFilterInternal][URL({}/{}) 未传递租户编号]", request.getRequestURI(), request.getMethod());
91:                WebFrameworkUtils.writeJSON(request, response, CommonResult.error(GlobalErrorCodeConstants.BAD_REQUEST.getCode(),
92:                        "请求的租户标识未传递，请进行排查"));
93:                return;
94:            }
95:            // 3. 校验租户是合法，例如说被禁用、到期
96:            try {
97:                tenantFrameworkService.validTenant(tenantId);
98:            } catch (Throwable ex) {
99:                CommonResult<?> result = globalExceptionHandler.allExceptionHandler(request, ex);
100:                WebFrameworkUtils.writeJSON(request, response, result);
101:                return;
102:            }
103:        } else { // 如果是允许忽略租户的 URL，若未传递租户编号，则默认忽略租户编号，避免报错
104:            if (tenantId == null) {
105:                TenantContextHolder.setIgnore(true);
106:            }
107:        }
108:
109:        // 继续过滤
110:        chain.doFilter(request, response);
111:    }
112:
113:    private boolean isIgnoreUrl(HttpServletRequest request) {
114:        String apiUri = request.getRequestURI().substring(request.getContextPath().length());
115:        // 快速匹配，保证性能
116:        if (CollUtil.contains(tenantProperties.getIgnoreUrls(), apiUri)
117:            || CollUtil.contains(ignoreUrls, apiUri)) {
118:            return true;
119:        }
120:        // 逐个 Ant 路径匹配
121:        for (String url : tenantProperties.getIgnoreUrls()) {
122:            if (pathMatcher.match(url, apiUri)) {
123:                return true;
124:            }
125:        }
126:        for (String url : ignoreUrls) {
127:            if (pathMatcher.match(url, apiUri)) {
128:                return true;
129:            }
130:        }
131:        return false;
132:    }
133:
134:}
