2:
3:import cn.zszj.framework.tenant.config.TenantProperties;
4:import cn.zszj.framework.tenant.core.aop.TenantIgnore;
5:import cn.zszj.framework.tenant.core.context.TenantContextHolder;
6:import com.baomidou.mybatisplus.core.metadata.TableInfo;
7:import com.baomidou.mybatisplus.core.metadata.TableInfoHelper;
8:import com.baomidou.mybatisplus.extension.plugins.handler.TenantLineHandler;
9:import com.baomidou.mybatisplus.extension.toolkit.SqlParserUtils;
10:import net.sf.jsqlparser.expression.Expression;
11:import net.sf.jsqlparser.expression.LongValue;
12:
13:import java.util.HashMap;
14:import java.util.Map;
15:
16:/**
17: * 基于 MyBatis Plus 多租户的功能，实现 DB 层面的多租户的功能
18: *
19: * @author 芋道源码
20: */
21:public class TenantDatabaseInterceptor implements TenantLineHandler {
22:
23:    /**
24:     * 忽略的表
25:     *
26:     * KEY：表名
27:     * VALUE：是否忽略
28:     */
29:    private final Map<String, Boolean> ignoreTables = new HashMap<>();
30:
31:    public TenantDatabaseInterceptor(TenantProperties properties) {
32:        // 不同 DB 下，大小写的习惯不同，所以需要都添加进去
33:        properties.getIgnoreTables().forEach(table -> {
34:            addIgnoreTable(table, true);
35:        });
36:        // 在 OracleKeyGenerator 中，生成主键时，会查询这个表，查询这个表后，会自动拼接 TENANT_ID 导致报错
37:        addIgnoreTable("DUAL", true);
38:    }
39:
40:    @Override
41:    public Expression getTenantId() {
42:        return new LongValue(TenantContextHolder.getRequiredTenantId());
43:    }
44:
45:    @Override
46:    public boolean ignoreTable(String tableName) {
47:        // 情况一，全局忽略多租户
48:        if (TenantContextHolder.isIgnore()) {
49:            return true;
50:        }
51:        // 情况二，忽略多租户的表
52:        tableName = SqlParserUtils.removeWrapperSymbol(tableName);
53:        Boolean ignore = ignoreTables.get(tableName.toLowerCase());
54:        if (ignore == null) {
55:            ignore = computeIgnoreTable(tableName);
56:            synchronized (ignoreTables) {
57:                addIgnoreTable(tableName, ignore);
58:            }
59:        }
60:        return ignore;
61:    }
62:
63:    private void addIgnoreTable(String tableName, boolean ignore) {
64:        ignoreTables.put(tableName.toLowerCase(), ignore);
65:        ignoreTables.put(tableName.toUpperCase(), ignore);
66:    }
67:
68:    private boolean computeIgnoreTable(String tableName) {
69:        // 找不到的表，说明不是 zszj 项目里的，不进行拦截（忽略租户）
70:        TableInfo tableInfo = TableInfoHelper.getTableInfo(tableName);
71:        if (tableInfo == null) {
72:            return true;
73:        }
74:        // 如果继承了 TenantBaseDO 基类，显然不忽略租户
75:        if (TenantBaseDO.class.isAssignableFrom(tableInfo.getEntityType())) {
76:            return false;
77:        }
78:        // 如果添加了 @TenantIgnore 注解，则忽略租户
79:        TenantIgnore tenantIgnore = tableInfo.getEntityType().getAnnotation(TenantIgnore.class);
80:        return tenantIgnore != null;
81:    }
82:
83:}
