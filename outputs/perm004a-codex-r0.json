211:    /**
212:     * 校验父菜单是否合法
213:     * <p>
214:     * 1. 不能设置自己为父菜单
215:     * 2. 父菜单不存在
216:     * 3. 父菜单必须是 {@link MenuTypeEnum#MENU} 菜单类型
217:     *
218:     * @param parentId 父菜单编号
219:     * @param childId  当前菜单编号
220:     */
221:    @VisibleForTesting
222:    void validateParentMenu(Long parentId, Long childId) {
223:        if (parentId == null || ID_ROOT.equals(parentId)) {
224:            return;
225:        }
226:        // 不能设置自己为父菜单
227:        if (parentId.equals(childId)) {
228:            throw exception(MENU_PARENT_ERROR);
229:        }
230:        MenuDO menu = menuMapper.selectById(parentId);
231:        // 父菜单不存在
232:        if (menu == null) {
233:            throw exception(MENU_PARENT_NOT_EXISTS);
234:        }
235:        // 父菜单必须是目录或者菜单类型
236:        if (!MenuTypeEnum.DIR.getType().equals(menu.getType())
237:                && !MenuTypeEnum.MENU.getType().equals(menu.getType())) {
238:            throw exception(MENU_PARENT_NOT_DIR_OR_MENU);
239:        }
240:    }
