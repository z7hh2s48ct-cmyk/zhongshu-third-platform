package cn.zszj.framework.redis.config;

import cn.hutool.core.util.StrUtil;
import cn.zszj.framework.redis.core.TimeoutRedisCacheManager;
import org.springframework.boot.autoconfigure.AutoConfiguration;
import org.springframework.boot.autoconfigure.cache.CacheProperties;
import org.springframework.boot.context.properties.EnableConfigurationProperties;
import org.springframework.cache.annotation.EnableCaching;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Primary;
import org.springframework.data.redis.cache.BatchStrategies;
import org.springframework.data.redis.cache.RedisCacheConfiguration;
import org.springframework.data.redis.cache.RedisCacheManager;
import org.springframework.data.redis.cache.RedisCacheWriter;
import org.springframework.data.redis.connection.RedisConnectionFactory;
import org.springframework.data.redis.core.RedisTemplate;
import org.springframework.data.redis.serializer.RedisSerializationContext;
import org.springframework.util.StringUtils;

import java.util.Objects;

import static cn.zszj.framework.redis.config.ZszjRedisAutoConfiguration.buildRedisSerializer;

/**
 * Cache �����࣬���� Redis ʵ��
 */
@AutoConfiguration
@EnableConfigurationProperties({CacheProperties.class, ZszjCacheProperties.class})
@EnableCaching
public class ZszjCacheAutoConfiguration {

    /**
     * RedisCacheConfiguration Bean
     * <p>
     * �ο� org.springframework.boot.autoconfigure.cache.RedisCacheConfiguration �� createConfiguration ����
     */
    @Bean
    @Primary
    public RedisCacheConfiguration redisCacheConfiguration(CacheProperties cacheProperties) {
        RedisCacheConfiguration config = RedisCacheConfiguration.defaultCacheConfig();
        // ����ʹ�� : ��ð�ţ�������˫ :: ð�ţ����� Redis Desktop Manager ����ո�
        // ��ϸ�ɼ� https://blog.csdn.net/chuixue24/article/details/103928965 ����
        // �ٴ��޸���ð�ţ�������˫ :: ð�����⣬Issues ���飺https://gitee.com/zhijiantianya/yudao-cloud/issues/I86VY2
        config = config.computePrefixWith(cacheName -> {
            String keyPrefix = cacheProperties.getRedis().getKeyPrefix();
            if (StringUtils.hasText(keyPrefix)) {
                keyPrefix = keyPrefix.lastIndexOf(StrUtil.COLON) == -1 ? keyPrefix + StrUtil.COLON : keyPrefix;
                return keyPrefix + cacheName + StrUtil.COLON;
            }
            return cacheName + StrUtil.COLON;
        });
        // ����ʹ�� JSON ���л���ʽ
        config = config.serializeValuesWith(
                RedisSerializationContext.SerializationPair.fromSerializer(buildRedisSerializer()));

        // ���� CacheProperties.Redis ������
        CacheProperties.Redis redisProperties = cacheProperties.getRedis();
        if (redisProperties.getTimeToLive() != null) {
            config = config.entryTtl(redisProperties.getTimeToLive());
        }
        if (!redisProperties.isCacheNullValues()) {
            config = config.disableCachingNullValues();
        }
        if (!redisProperties.isUseKeyPrefix()) {
            config = config.disableKeyPrefix();
        }
        return config;
    }

    @Bean
    public RedisCacheManager redisCacheManager(RedisTemplate<String, Object> redisTemplate,
                                               RedisCacheConfiguration redisCacheConfiguration,
                                               ZszjCacheProperties zszjCacheProperties) {
        // ���� RedisCacheWriter ����
        RedisConnectionFactory connectionFactory = Objects.requireNonNull(redisTemplate.getConnectionFactory());
        RedisCacheWriter cacheWriter = RedisCacheWriter.nonLockingRedisCacheWriter(connectionFactory,
                BatchStrategies.scan(zszjCacheProperties.getRedisScanBatchSize()));
        // ���� TimeoutRedisCacheManager ����
        TimeoutRedisCacheManager cacheManager = new TimeoutRedisCacheManager(cacheWriter, redisCacheConfiguration);
        // ���������֪��@Transactional �����ڵ� @CacheEvict / @CachePut �Զ��ӳٵ� afterCommit��
        //             ��������δ�ύ���建�汻��������д��ֵ��������ʱ������Ч����Ϊ����
        cacheManager.setTransactionAware(true);
        return cacheManager;
    }

}
package cn.zszj.framework.tenant.core.redis;

import cn.hutool.core.collection.CollUtil;
import cn.hutool.core.util.StrUtil;
