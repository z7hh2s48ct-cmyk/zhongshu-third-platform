    @Override
    // ZS-PERM-004.A������ Spring @Transactional����@DSTransactional��dynamic-datasource ��������
    // ������ Spring ����ͬ������������ʱ�������� Spring ���񷽷���һ�£�system ģ�鵥�⣬����ȼۣ�
    @Transactional(rollbackFor = Exception.class)
    @Caching(evict = {
            @CacheEvict(value = RedisKeyConstants.MENU_ROLE_ID_LIST,
            allEntries = true),
            @CacheEvict(value = RedisKeyConstants.PERMISSION_MENU_ID_LIST,
            allEntries = true) // allEntries ������л��棬��Ҫһ�θ����漰���� menuIds �϶࣬�������������
    })
    public void assignRoleMenu(Long roleId, Set<Long> menuIds) {
        // ZS-PERM-001.A������ǰУ���ɫ��������ֹ�۸����⻧��ɫ ID д�����
        validateRoleForAssign(roleId);
        // ��ý�ɫӵ�в˵����
        Set<Long> dbMenuIds = convertSet(roleMenuMapper.selectListByRoleId(roleId), RoleMenuDO::getMenuId);
        // ����������ɾ���Ĳ˵����
        Set<Long> menuIdList = CollUtil.emptyIfNull(menuIds);
        Collection<Long> createMenuIds = CollUtil.subtract(menuIdList, dbMenuIds);
        Collection<Long> deleteMenuIds = CollUtil.subtract(dbMenuIds, menuIdList);
        // ִ��������ɾ���������Ѿ���Ȩ�Ĳ˵����������κδ���
        if (CollUtil.isNotEmpty(createMenuIds)) {
            roleMenuMapper.insertBatch(CollectionUtils.convertList(createMenuIds, menuId -> {
                RoleMenuDO entity = new RoleMenuDO();
                entity.setRoleId(roleId);
                entity.setMenuId(menuId);
                return entity;
            }));
        }
        if (CollUtil.isNotEmpty(deleteMenuIds)) {
            roleMenuMapper.deleteListByRoleIdAndMenuIds(roleId, deleteMenuIds);
        }
    }

    @Override
