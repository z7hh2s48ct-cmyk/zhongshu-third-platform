                if (Objects.equals(role.getCode(), RoleCodeEnum.TENANT_ADMIN.getCode())) {
                    permissionService.assignRoleMenu(role.getId(), menuIds);
                    log.info("[updateTenantRoleMenu][租户管理�?{}/{}) 的权限修改为({})]", role.getId(), role.getTenantId(), menuIds);
                    return;
