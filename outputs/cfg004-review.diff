diff --git a/services/zhongshu-core/zszj-module-infra/src/main/java/cn/zszj/module/infra/service/config/ConfigValueValidator.java b/services/zhongshu-core/zszj-module-infra/src/main/java/cn/zszj/module/infra/service/config/ConfigValueValidator.java
