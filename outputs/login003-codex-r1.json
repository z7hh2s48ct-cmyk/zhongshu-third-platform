 444:     @Override
 445:     public Integer cleanRefreshToken(Integer exceedDay, Integer deleteLimit) {
 446:         int count = 0;
 447:         LocalDateTime expireDate = DateUtils.now().minusDays(exceedDay);
 448:         // 循环删除，直到没有满足条件的数据
 449:         for (int i = 0; i < Short.MAX_VALUE; i++) {
 450:             int deleteCount = oauth2RefreshTokenMapper.deleteByExpiresTimeLt(expireDate, deleteLimit);
 451:             count += deleteCount;
 452:             // 达到删除预期条数，说明到底了
 453:             if (deleteCount < deleteLimit) {
 454:                 break;
 455:             }
 456:         }
 457:         return count;
 458:     }
