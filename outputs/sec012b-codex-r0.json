32:import java.util.Map;
33:import java.util.function.Predicate;
34:
35:@AutoConfiguration
36:@EnableConfigurationProperties(WebProperties.class)
37:public class ZszjWebAutoConfiguration {
38:
39:    /**
40:     * 应用名
41:     */
42:    @Value("${spring.application.name}")
43:    private String applicationName;
44:
45:    @Bean
46:    public WebMvcRegistrations webMvcRegistrations(WebProperties webProperties) {
47:        return new WebMvcRegistrations() {
48:
49:            @Override
50:            public RequestMappingHandlerMapping getRequestMappingHandlerMapping() {
51:                RequestMappingHandlerMapping mapping = new RequestMappingHandlerMapping();
52:                // 实例化时就带上前缀
53:                mapping.setPathPrefixes(buildPathPrefixes(webProperties));
54:                return mapping;
55:            }
56:
57:            /**
58:             * 构建 prefix → 匹配条件的映射
59:             */
60:            private Map<String, Predicate<Class<?>>> buildPathPrefixes(WebProperties webProperties) {
61:                AntPathMatcher antPathMatcher = new AntPathMatcher(".");
62:                Map<String, Predicate<Class<?>>> pathPrefixes = Maps.newLinkedHashMapWithExpectedSize(2);
63:                putPathPrefix(pathPrefixes, webProperties.getAdminApi(), antPathMatcher);
64:                putPathPrefix(pathPrefixes, webProperties.getAppApi(), antPathMatcher);
65:                return pathPrefixes;
66:            }
67:
68:            /**
69:             * 设置 API 前缀，仅仅匹配 controller 包下的
70:             */
71:            private void putPathPrefix(Map<String, Predicate<Class<?>>> pathPrefixes, WebProperties.Api api, AntPathMatcher matcher) {
72:                if (api == null || StrUtil.isEmpty(api.getPrefix())) {
73:                    return;
74:                }
75:                pathPrefixes.put(api.getPrefix(), // api 前缀
76:                        clazz -> clazz.isAnnotationPresent(RestController.class)
77:                                && matcher.match(api.getController(), clazz.getPackage().getName()));
78:            }
79:
80:        };
81:    }
82:
83:    @Bean
84:    @SuppressWarnings("SpringJavaInjectionPointsAutowiringInspection")
85:    public GlobalExceptionHandler globalExceptionHandler(ApiErrorLogCommonApi apiErrorLogApi) {
86:        return new GlobalExceptionHandler(applicationName, apiErrorLogApi);
87:    }
88:
89:    @Bean
90:    public GlobalResponseBodyHandler globalResponseBodyHandler() {
91:        return new GlobalResponseBodyHandler();
92:    }
93:
94:    @Bean
95:    @SuppressWarnings("InstantiationOfUtilityClass")
96:    public WebFrameworkUtils webFrameworkUtils(WebProperties webProperties) {
97:        // 由于 WebFrameworkUtils 需要使用到 webProperties 属性，所以注册为一个 Bean
98:        return new WebFrameworkUtils(webProperties);
99:    }
100:
101:    // ========== Filter 相关 ==========
102:
103:    /**
104:     * 创建 CorsFilter Bean，解决跨域问题
105:     *
106:     * ZS-SEC-004：由全通配收紧为精确白名单——源/方法/头/暴露头/凭据/maxAge 全部读取 {@link WebProperties.Cors}，
107:     * 默认仅本地开发源，杜绝“allowedOriginPattern=* + allowCredentials=true”的任意源携带凭据缺陷。
108:     */
109:    @Bean
110:    @Order(value = WebFilterOrderEnum.CORS_FILTER) // 特殊：修复因执行顺序影响到跨域配置不生效问题
111:    public FilterRegistrationBean<CorsFilter> corsFilterBean(WebProperties webProperties) {
112:        WebProperties.Cors cors = webProperties.getCors();
113:        // 创建 CorsConfiguration 对象
114:        CorsConfiguration config = new CorsConfiguration();
115:        config.setAllowCredentials(cors.isAllowCredentials());
116:        cors.getAllowedOriginPatterns().forEach(config::addAllowedOriginPattern); // 设置访问源地址（精确白名单）
117:        cors.getAllowedHeaders().forEach(config::addAllowedHeader); // 设置访问源请求头
118:        cors.getAllowedMethods().forEach(config::addAllowedMethod); // 设置访问源请求方法
119:        cors.getExposedHeaders().forEach(config::addExposedHeader); // 设置暴露给浏览器的响应头
120:        config.setMaxAge(cors.getMaxAge()); // 预检缓存秒数
121:        // 创建 UrlBasedCorsConfigurationSource 对象
122:        UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
123:        source.registerCorsConfiguration("/**", config); // 对接口配置跨域设置
124:        return createFilterBean(new CorsFilter(source), WebFilterOrderEnum.CORS_FILTER);
125:    }
126:
127:    /**
128:     * 创建 RequestBodyCacheFilter Bean，可重复读取请求内容
129:     */
130:    @Bean
131:    public FilterRegistrationBean<CacheRequestBodyFilter> requestBodyCacheFilter(WebProperties webProperties) {
132:        // ZS-SEC-008：注入 JSON 请求体缓冲上限，缓冲前受控拒绝超大 body
133:        return createFilterBean(new CacheRequestBodyFilter(webProperties.getRequestBody().getMaxCacheSize()),
134:                WebFilterOrderEnum.REQUEST_BODY_CACHE_FILTER);
135:    }
136:
137:    /**
138:     * 创建 DemoFilter Bean，演示模式
139:     */
140:    @Bean
141:    @ConditionalOnProperty(value = "zszj.demo", havingValue = "true")
142:    public FilterRegistrationBean<DemoFilter> demoFilter() {
143:        return createFilterBean(new DemoFilter(), WebFilterOrderEnum.DEMO_FILTER);
144:    }
145:
146:    public static <T extends Filter> FilterRegistrationBean<T> createFilterBean(T filter, Integer order) {
147:        FilterRegistrationBean<T> bean = new FilterRegistrationBean<>(filter);
148:        bean.setOrder(order);
149:        return bean;
150:    }
151:
152:    /**
153:     * 创建 RestTemplate 实例
154:     *
155:     * @param restTemplateBuilder {@link RestTemplateAutoConfiguration#restTemplateBuilder}
156:     */
157:    @Bean
158:    @ConditionalOnMissingBean
159:    public RestTemplate restTemplate(RestTemplateBuilder restTemplateBuilder) {
160:        return restTemplateBuilder.build();
161:    }
162:
163:}
