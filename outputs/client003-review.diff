+
+  it('调用方显式 header.isToken=false 时不附带 Token（批准来源）', () => {
+    const options = invoke({
+      url: 'https://api.zszj.test/admin-api/system/user/profile/get',
+      method: 'GET',
+      header: { isToken: false },
