import java.sql.*;
var url = \"jdbc:h2:mem:cfgReview;MODE=MYSQL;DB_CLOSE_DELAY=-1\";
var setup = DriverManager.getConnection(url);
setup.createStatement().execute(\"create table pkg(id int primary key, menus varchar); create table tenant(id int primary key, package_id int); create table role_menu(role_id int, menu_id int); insert into pkg values(1,'1,3'),(2,'1,3'); insert into tenant values(10,1); insert into role_menu values(100,1)\");
var shrink = DriverManager.getConnection(url);
var change = DriverManager.getConnection(url);
shrink.setAutoCommit(false);
change.setAutoCommit(false);
shrink.createStatement().executeUpdate(\"update pkg set menus='1' where id=2\");
var listed = shrink.createStatement().executeQuery(\"select id from tenant where package_id=2\");
System.out.println(\"shrink lists incoming tenant = \" + listed.next());
var old = change.createStatement().executeQuery(\"select menus from pkg where id=2\"); old.next(); System.out.println(\"switch package validation sees = \" + old.getString(1));
change.createStatement().executeUpdate(\"update tenant set package_id=2 where id=10\");
var locked = change.createStatement().executeQuery(\"select * from tenant where id=10 for update\"); locked.next();
var ceiling = change.createStatement().executeQuery(\"select menus from pkg where id=2\"); ceiling.next(); System.out.println(\"grant under tenant lock sees = \" + ceiling.getString(1));
change.createStatement().executeUpdate(\"insert into role_menu values(100,3)\");
change.commit();
shrink.commit();
var finalState = setup.createStatement().executeQuery(\"select p.menus,rm.menu_id from tenant t join pkg p on t.package_id=p.id join role_menu rm on rm.role_id=100 where rm.menu_id=3\"); finalState.next(); System.out.println(\"FINAL package menus=\" + finalState.getString(1) + \", role retains=\" + finalState.getInt(2));
/exit
