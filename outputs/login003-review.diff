+        assertFalse(TenantContextHolder.isIgnore(), "校验失败后必须恢复调用方的租户忽略标记");
+        assertEquals(Long.valueOf(1L), TenantContextHolder.getTenantId(), "校验失败后必须保留调用方的租户编号");
+    }
