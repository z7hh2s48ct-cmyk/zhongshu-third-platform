175: export const httpInterceptor = {
176:   // 拦截前触发
177:   invoke(options: CustomRequestOptions) {
178:     // 接口请求支持通过 query 参数配置 queryString
179:     if (options.query) {
180:       const queryStr = stringifyQuery(options.query)
181:       if (options.url.includes('?')) {
182:         options.url += `&${queryStr}`
183:       }
184:       else {
185:         options.url += `?${queryStr}`
186:       }
187:     }
188:     // 非 http 开头需拼接地址
189:     if (!options.url.startsWith('http')) {
190:       // #ifdef H5
191:       if (JSON.parse(import.meta.env.VITE_APP_PROXY_ENABLE)) {
192:         // 自动拼接代理前缀
193:         options.url = import.meta.env.VITE_APP_PROXY_PREFIX + options.url
194:       }
195:       else {
196:         options.url = baseUrl + options.url
197:       }
198:       // #endif
199:       // 非H5正常拼接
200:       // #ifndef H5
201:       options.url = baseUrl + options.url
202:       // #endif
203:       // TIPS: 如果需要对接多个后端服务，也可以在这里处理，拼接成所需要的地址
204:     }
205:     // 1. 请求超时
206:     options.timeout = 60000 // 60s
207:     // 2. （可选）添加小程序端请求头标识
208:     options.header = {
209:       ...options.header,
210:     }
211:     // 3. ZS-CLIENT-003（B03）：凭据范围判定（修正原布尔反义缺陷）
212:     //    - isApproved：仅批准 API origin 才携带平台凭据（Token / 租户头 / trace-id）
213:     //    - callerOptOut：调用方显式 header.isToken === false
214:     //    - whitelisted：登录 / 刷新令牌 / 租户查询等白名单路径（精确段边界匹配）
215:     //    仅当三者共同允许（allowToken）时才附带 Token，杜绝白名单/外部来源泄露凭据
216:     const isApproved = isApprovedApiOrigin(options.url, approvedOrigin)
217:     const callerOptOut = (options.header || {}).isToken === false
218:     const whitelisted = isWhitelistedPath(options.url)
219:     const allowToken = isApproved && !callerOptOut && !whitelisted
220: 
221:     const tokenStore = useTokenStore()
222:     const token = tokenStore.updateNowTime().validToken
223:     if (allowToken && token) {
224:       options.header.Authorization = `Bearer ${token}`
225:     }
226: 
227:     // 4. 添加租户标识（仅批准来源；登录仍需租户上下文，故 tenant-id 只受 isApproved 约束）
228:     if (isApproved && tenantEnable && tenantEnable === 'true') {
229:       const tenantId = useUserStore().tenantId
230:       if (tenantId) {
231:         options.header['tenant-id'] = tenantId
232:       }
233:       // ZS-SEC-001.A：仅当跨租户访问能力显式开启、且本次请求确实允许携带 Token 时才注入 visit-tenant-id 头；
234:       // 默认关闭时前端不发送该头，后端拦截器亦会拒绝，形成前后端双重收口
235:       if (tenantVisitEnable === 'true' && allowToken) {
236:         const visitTenantId = useUserStore().visitTenantId
237:         if (token && visitTenantId) {
238:           options.header['visit-tenant-id'] = visitTenantId
239:         }
240:       }
241:     }
242: 
243:     // 5. trace/correlation 标识透传（ZS-SEC-006）：仅批准来源注入/回显，外部来源不携带
244:     if (isApproved) {
245:       ensureTraceId(options.header)
246:     }
247: 
248:     // 6. add by panda：是否 API 加密
249:     if (options.isEncrypt) {
250:       try {
251:         // 加密请求数据
252:         if (options.data) {
253:           options.data = ApiEncrypt.encryptRequest(options.data)
254:           // 设置加密标识头
255:           options.header[ApiEncrypt.getEncryptHeader()] = 'true'
256:         }
257:       } catch (error) {
258:         console.error('请求数据加密失败:', error)
259:         throw error
260:       }
261:     }
262: 
263:     return options
264:   },
265: }
