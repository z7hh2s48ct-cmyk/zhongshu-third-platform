# ZS-CLIENT-005.B 本地联验一次性口令模板（.env.local 已 gitignore，禁止提交）
# 使用：cp .env.local.example .env.local（本目录下的值即本地联验默认值，可直接用；
#       口令为一次性本地值，禁止与任何真实环境相同）

# PG owner（Flyway 以该账号执行全迁移链）
ZSZJ_PG_BOOTSTRAP_USERNAME=zhongshu_owner
ZSZJ_PG_BOOTSTRAP_PASSWORD=local-lianyan-owner

# 应用账号（postgres-init 创建，供后续凭据分离演练使用）
ZSZJ_DATASOURCE_USERNAME=zhongshu_app
ZSZJ_DATASOURCE_PASSWORD=local-lianyan-app
