# ZS-OPS-002.A 配置注入合同（.env.example）
# 前置：ZS-ENG-003（环境配置分离）、ZS-CFG-001.A（秘密门禁）
#
# 使用：cp .env.example .env && vim .env（填入真实值后 .env 不得提交）
# 合同原则：
#   1. 本文件中所有值均为占位符或空，禁止出现真实凭据
#   2. 缺必填项时 zszj-server 应启动失败并输出明确错误（非静默降级）
#   3. 敏感项（*_PASSWORD、*_KEY、*_TOKEN）不得落镜像、不得写日志

# ---- 服务端口 ----
# zszj-server HTTP 端口（默认 48080，与 Dockerfile EXPOSE 一致）
# 注意：nginx upstream 硬编码 48080；如修改此值需同步更新 nginx/zszj-server.conf
ZSZJ_SERVER_PORT=48080

# ---- Spring Profile ----
# 部署环境 Profile（prod/staging/test，对应 application-{profile}.yaml）
ZSZJ_PROFILE=prod

# ---- PostgreSQL 初始化（owner/超级用户，仅首次建库时使用）----
# 与应用账号分离（ZS-DB-002）：此账号拥有 DDL 权限，仅供 Flyway 迁移和初始化
# 应用日常运行使用下方的 ZSZJ_DATASOURCE_* 低权限账号
ZSZJ_PG_BOOTSTRAP_USERNAME=zhongshu_owner
ZSZJ_PG_BOOTSTRAP_PASSWORD=

# ---- 数据库（PostgreSQL，应用低权限账号）----
# JDBC URL（格式：jdbc:postgresql://HOST:PORT/DB?params）
# 容器内网络地址为 postgres:5432；外部访问填实际地址
ZSZJ_DATASOURCE_URL=jdbc:postgresql://postgres:5432/zhongshu
ZSZJ_DATASOURCE_USERNAME=zhongshu_app
ZSZJ_DATASOURCE_PASSWORD=

# ---- Redis ----
# 容器内网络地址为 redis:6379；外部访问填实际地址
# Spring Boot 3.x 使用 spring.data.redis.*（application-prod.yaml 已正确映射）
ZSZJ_REDIS_HOST=redis
ZSZJ_REDIS_PORT=6379
ZSZJ_REDIS_PASSWORD=

# ---- TLS 证书路径（宿主机路径，volume mount 注入 nginx 容器）----
# 证书文件禁止入版本库；由 certbot/运维手动放置
ZSZJ_TLS_CERT_PATH=./tls/fullchain.pem
ZSZJ_TLS_KEY_PATH=./tls/privkey.pem

# ---- 可选：对象存储（ZS-FILE-005.B 交付后补充，本批 .A 不涉及）----
# ZSZJ_OSS_ENDPOINT=
# ZSZJ_OSS_ACCESS_KEY=
# ZSZJ_OSS_SECRET_KEY=
# ZSZJ_OSS_BUCKET=
