# 标题
VITE_APP_TITLE=众墅之家 AI 赋能平台

# 项目本地运行端口号
VITE_PORT=80

# open 运行 npm run dev 时自动打开浏览器
VITE_OPEN=true

# 租户开关
VITE_APP_TENANT_ENABLE=true

# 跨租户访问（visit-tenant-id）能力总开关，默认关闭
# ZS-SEC-001.A：底座默认关闭未经批准的跨租户浏览能力，前后端共同收口。
# 仅当后端 zszj.tenant.visit-enable=true 且已获批受控跨组织访问时，才置为 true。
VITE_APP_TENANT_VISIT_ENABLE=false

# 验证码的开关
VITE_APP_CAPTCHA_ENABLE=true

# 文档地址的开关
VITE_APP_DOCALERT_ENABLE=true

# 百度统计
VITE_APP_BAIDU_CODE =

# 默认账户密码
VITE_APP_DEFAULT_LOGIN_TENANT = 众墅之家
VITE_APP_DEFAULT_LOGIN_USERNAME = admin
VITE_APP_DEFAULT_LOGIN_PASSWORD=

# API 加解密
VITE_APP_API_ENCRYPT_ENABLE = true
VITE_APP_API_ENCRYPT_HEADER = X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM = AES
VITE_APP_API_ENCRYPT_REQUEST_KEY=
VITE_APP_API_ENCRYPT_RESPONSE_KEY=

# 百度地图
VITE_BAIDU_MAP_KEY=